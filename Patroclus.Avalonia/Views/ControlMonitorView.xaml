<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Patroclus.Avalonia.Views.ControlMonitorView">
  <StackPanel Margin="6" Spacing="4">

    <TextBlock Text="CLIENT CONTROLS     •     Green: active     •     Dark: inactive / unobserved"
               Foreground="#92A5BD" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,4"/>
    <TextBlock Text="{Binding Activity}" Foreground="#92A5BD" FontSize="10"/>
    <ItemsControl Items="{Binding Groups}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border BorderBrush="#28384C" Background="#131E2D" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,8,8" IsVisible="{Binding !IsRaw}">
            <StackPanel Spacing="3">
              <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <ItemsControl Items="{Binding Lamps}" IsVisible="{Binding !IsRaw}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="16,*" Margin="0,3,10,3" MinHeight="20" ToolTip.Tip="{Binding Detail}">
                      <Ellipse Width="16" Height="16" Fill="{Binding Color}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding DisplayText}" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="#E6EEF8" TextWrapping="Wrap"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl Items="{Binding Lamps}" IsVisible="{Binding IsRaw}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,2" Orientation="Horizontal" Spacing="5">
                      <Ellipse Width="16" Height="16" Fill="{Binding Color}" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Detail}" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" MaxWidth="330" VerticalAlignment="Center"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>


