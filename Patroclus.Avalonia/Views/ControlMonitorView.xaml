<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Patroclus.Avalonia.Views.ControlMonitorView">
  <StackPanel Margin="6" Spacing="4">

    <TextBlock Text="Green: ON · Dark: no active state reported · ?: not received yet · Last received client commands"
               FontSize="11" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding FilterDescription}" TextWrapping="Wrap" FontSize="11"/>
    <TextBlock Text="{Binding Activity}" Foreground="#475569" FontSize="10"/>
    <ItemsControl Items="{Binding Groups}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="7,5" Margin="0,0,5,5">
            <StackPanel Spacing="3">
              <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold"/>
              <ItemsControl Items="{Binding Lamps}" IsVisible="{Binding !IsRaw}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,3,12,3" Spacing="5" MinWidth="78" ToolTip.Tip="{Binding Detail}">
                      <Ellipse Width="16" Height="16" Fill="{Binding Color}" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding CompactDetail}" FontSize="10" Foreground="#475569" VerticalAlignment="Center"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl Items="{Binding Lamps}" IsVisible="{Binding IsRaw}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,2" Orientation="Horizontal" Spacing="5">
                      <Ellipse Width="16" Height="16" Fill="{Binding Color}" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Detail}" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" MaxWidth="330" VerticalAlignment="Center"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>


