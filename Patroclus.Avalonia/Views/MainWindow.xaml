<Window xmlns="https://github.com/avaloniaui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:v="clr-namespace:Patroclus.Avalonia.Views;assembly=Patroclus.Avalonia"
 xmlns:audio="clr-namespace:Patroclus.Avalonia.Audio;assembly=Patroclus.Avalonia"
 Icon="avares://Patroclus.Avalonia/Assets/avalonia-logo.ico"
 Title="OpenHPSDR-Sim — Radio Console"
 x:Class="Patroclus.Avalonia.Views.MainWindow" x:Name="EmulatorWindow"
 Width="1160" Height="800" MinWidth="880" MinHeight="620">
 <DockPanel Margin="18,14">
  <StackPanel DockPanel.Dock="Top" Spacing="12">
   <Grid ColumnDefinitions="*,Auto">
    <StackPanel>
     <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="OPENHPSDR" FontSize="21" FontWeight="Bold"/>
      <TextBlock Text="/ SIM" FontSize="21" Foreground="#2DD4BF" FontWeight="Light"/>
     </StackPanel>
     <TextBlock Text="RADIO EMULATOR  /  CLIENT MONITOR" Classes="muted" FontSize="10" Margin="0,3,0,0"/>
    </StackPanel>
    <ToggleButton Grid.Column="1" Content="Always on top" VerticalAlignment="Center" Padding="12,7"
     IsChecked="{Binding Topmost, ElementName=EmulatorWindow, Mode=TwoWay}"
     ToolTip.Tip="Keep the emulator above other windows."/>
   </Grid>
   <Border Classes="card">
    <Grid ColumnDefinitions="280,*,270">
     <StackPanel Spacing="5" Margin="0,0,18,0">
      <TextBlock Text="RADIO PROFILE" Classes="muted" FontSize="10"/>
      <ComboBox Items="{Binding RadioProfiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
       HorizontalAlignment="Stretch" MaxDropDownHeight="420"/>
      <TextBlock Text="{Binding SelectedProfile.Description}" Classes="muted" FontSize="11"/>
     </StackPanel>
     <Border Grid.Column="1" BorderBrush="#28384C" BorderThickness="1,0,0,0" Padding="18,0,0,0">
      <StackPanel DataContext="{Binding radio.Monitor}" Spacing="7" VerticalAlignment="Center">
       <TextBlock Text="CLIENT CONNECTION" Classes="muted" FontSize="10"/>
       <WrapPanel>
        <Ellipse Width="16" Height="16" Fill="{Binding ClientColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding ClientEndpoint}" FontWeight="SemiBold" FontSize="15" Margin="0,0,14,0"/>
        <TextBlock Text="{Binding ClientStatus}" Foreground="#2DD4BF" VerticalAlignment="Center"/>
       </WrapPanel>
       <TextBlock Text="{Binding ProtocolLabel}" Classes="muted" FontSize="11"
        ToolTip.Tip="HPSDR reports the client endpoint, but not its application name."/>
      </StackPanel>
     </Border>
     <Border Grid.Column="2" Background="#07150F" BorderBrush="#20533A" BorderThickness="1"
      CornerRadius="6" Padding="12,8" Margin="16,0,0,0" DataContext="{Binding radio.Monitor}"
      ToolTip.Tip="Client-requested RX hardware frequency. P2 uses the first active DDC. With CTUN, the client's displayed VFO may differ.">
      <StackPanel Spacing="4" VerticalAlignment="Center">
       <TextBlock Text="RX FREQUENCY" Foreground="#73AD8D" FontSize="10"/>
       <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <TextBlock Text="{Binding ReceiveFrequencyKhz}" FontFamily="Consolas" FontSize="30" FontWeight="Bold" Foreground="#4ADE80"/>
        <TextBlock Text="kHz" Foreground="#73AD8D" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
       </StackPanel>
      </StackPanel>
     </Border>
    </Grid>
   </Border>
   <Border Classes="card" DataContext="{Binding radio}">
    <StackPanel Spacing="7">
     <WrapPanel>
      <TextBlock Text="TX AUDIO" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,14,0"/>
      <ComboBox x:Name="RecordingMode" SelectedIndex="0" MinWidth="76" IsEnabled="{Binding CanChangeRecordingMode}" Margin="0,0,8,0">
       <ComboBoxItem Content="USB" Tag="{x:Static audio:TxAudioMode.USB}"/>
       <ComboBoxItem Content="LSB" Tag="{x:Static audio:TxAudioMode.LSB}"/>
       <ComboBoxItem Content="AM" Tag="{x:Static audio:TxAudioMode.AM}"/>
       <ComboBoxItem Content="FM" Tag="{x:Static audio:TxAudioMode.FM}"/>
       <ComboBoxItem Content="SSB" Tag="{x:Static audio:TxAudioMode.SSB}"/>
      </ComboBox>
      <Button Classes="primary" Content="Record WAV…" Click="StartRecording" IsEnabled="{Binding CanStartManualRecording}" Margin="0,0,8,0"/>
      <Button Content="Stop" Click="StopRecording" IsEnabled="{Binding IsRecording}" Margin="0,0,8,0"/>
      <Button Content="{Binding AutoRecordButtonText}" Click="ToggleAutoRecording" IsEnabled="{Binding !IsRecording}" Margin="0,0,14,0"/>
      <TextBlock Text="{Binding RecordingStatus}" Classes="muted" FontSize="11" VerticalAlignment="Center"/>
     </WrapPanel>
     <WrapPanel>
      <TextBlock Text="{Binding RxTxStatus}" Foreground="#2DD4BF" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0"/>
      <CheckBox Content="Mute RX during TX" IsChecked="{Binding MuteRxDuringTx, Mode=TwoWay}"
       ToolTip.Tip="Mute receiver IQ on PTT while packet clocks continue."/>
     </WrapPanel>
     <TextBlock x:Name="RecordingError" Foreground="#FB7185" FontSize="11" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
  </StackPanel>
  <Expander DockPanel.Dock="Bottom" Header="Diagnostics &amp; recording details" Margin="0,10,0,0">
   <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
    <StackPanel DataContext="{Binding radio}" Spacing="5" Margin="12,7">
     <TextBlock Text="{Binding TxInputStatus}" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding StreamTimingStatus}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding ControlInputStatus}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding AutoRecordingStatus}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding Monitor.FilterDescription}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
     <TextBlock Text="Match the recording mode to your client. WAV: 48 kHz / 16-bit / mono. FM assumes 5 kHz deviation. Hardware microphone input is silent; use client VAC for PC speech."
      Classes="muted" FontSize="11" TextWrapping="Wrap"/>
     <ItemsControl Items="{Binding Monitor.Groups}">
      <ItemsControl.ItemTemplate><DataTemplate>
       <ItemsControl Items="{Binding Lamps}" IsVisible="{Binding IsRaw}">
        <ItemsControl.ItemTemplate><DataTemplate>
         <TextBlock Text="{Binding Detail}" FontFamily="Consolas" Classes="muted" FontSize="11"/>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
   </ScrollViewer>
  </Expander>
  <TabControl Margin="0,12,0,0">
   <TabItem>
    <TabItem.Header><TextBlock Text="Radio" FontSize="15" FontWeight="SemiBold" Foreground="White"/></TabItem.Header>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <v:ControlMonitorView DataContext="{Binding radio.Monitor}"/>
    </ScrollViewer>
   </TabItem>
   <TabItem>
    <TabItem.Header><TextBlock Text="Hardware / OC" FontSize="15" FontWeight="SemiBold" Foreground="White"/></TabItem.Header>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <v:HardwareOptionsView DataContext="{Binding radio.Monitor}"/>
    </ScrollViewer>
   </TabItem>
   <TabItem>
    <TabItem.Header><TextBlock Text="Signal generator" FontSize="15" FontWeight="SemiBold" Foreground="White"/></TabItem.Header>
    <v:FakeRadioView DataContext="{Binding radio}"/>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
